# PUBLIC DEMO is safe by default; configure these in your host's secret variables.
PAVZA_DATA_DIR=/data
PAVZA_SITE_ENV=portfolio_demo
PAVZA_ALLOW_SUBMISSIONS=0
PAVZA_TIMEZONE=Europe/Kyiv
# Set only on FIRST RUN with a stable persistent volume. NEVER commit real values.
PAVZA_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_LONG_SECRET_AT_FIRST_DEPLOY
# Optional if you rotate storage or migrate instances. Never commit real values.
# PAVZA_SESSION_SECRET=REPLACE_WITH_64_RANDOM_CHAR_SECRET
